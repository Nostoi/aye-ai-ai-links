<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aye-links</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>--env-file=@HOME@/.aye-links/aye.env</string>
    <string>dist/server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HOME@/.aye-links/current</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ExitTimeOut</key>
  <integer>20</integer>
  <key>StandardOutPath</key>
  <string>@HOME@/.aye-links/logs/aye-links.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.aye-links/logs/aye-links.err.log</string>
</dict>
</plist>
