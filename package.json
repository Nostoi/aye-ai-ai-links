{
  "name": "aye-ai-ai-links",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "keys": "npm run build && node --env-file-if-exists=.env dist/cli/keys-main.js",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .githooks; fi"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
