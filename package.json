{
  "name": "aye-ai-ai-links",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "keys": "npm run build && node --env-file-if-exists=.env dist/cli/keys-main.js",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .githooks; fi"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.3.1",
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.13",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "undici": "8.11.2",
    "zod": "4.6.5"
  }
}
